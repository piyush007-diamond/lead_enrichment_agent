    "filter_max_reviews": 500,
    "contact_title_pattern": "Dr\\.?[\\s]+([A-Z][a-z]+(?:\\s+[A-Z][a-z]+)+)",
    "priority_keywords": [
      "on-site"
    ]
  },
  "hvac": {
